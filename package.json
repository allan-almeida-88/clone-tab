{
  "name": "clone-tab",
  "version": "1.0.0",
  "description": "Estudos",
  "main": "index.js",
  "scripts": {
    "dev": "npm run wait-for-postgres && npm run migrate:up && next dev",
    "build": "next build",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "npm run wait-for-postgres && npm run migrate:up && concurrently 'nex dev' 'jest --runInBand'",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --runInBand",
    "test:ci": "jest --ci",
    "migrate:create": "node-pg-migrate -m infra/migrations create",
    "migrate:up": "node-pg-migrate -m infra/migrations --envPath .env up",
    "migrate:down": "node-pg-migrate -m infra/migrations --envPath .env down",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "^1.3.3",
    "dotenv": "^16.4.4",
    "dotenv-expand": "^11.0.6",
    "install": "^0.13.0",
    "next": "^15.5.19",
    "node-pg-migrate": "^6.2.2",
    "npm": "^10.9.8",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.6.2",
    "prettier": "^3.8.3"
  }
}
